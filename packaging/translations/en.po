msgctxt "STRINGS.ELEMENTS.BAIYEFORBIDDENPROTOMATTER.DESC"
msgid "A dense, stable aggregate with a dark crust, violet grains and cyan inner strata. Produced by mass crushing or paid energy condensation; used for material compilation and controlled annihilation. Recoverable energy budget: up to 12 MJ/kg; condensation costs 18 MJ/kg. Store and convey it as a solid. The material itself is non-radioactive; radiation occurs inside the active reactor."
msgstr "A dense, stable aggregate with a dark crust, violet grains and cyan inner strata. Produced by mass crushing or paid energy condensation; used for material compilation and controlled annihilation. Recoverable energy budget: up to 12 MJ/kg; condensation costs 18 MJ/kg. Store and convey it as a solid. The material itself is non-radioactive; radiation occurs inside the active reactor."

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEPROTOANNIHILATIONREACTOR.NAME"
msgid "Proto-Matter Annihilation Reactor"
msgstr "Proto-Matter Annihilation Reactor"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEPROTOANNIHILATIONREACTOR.DESC"
msgid "Experimental confinement converts Proto-Matter rest mass into usable energy. The colony must supply fuel, cooling and maintenance for this extreme engineering process."
msgstr "Experimental confinement converts Proto-Matter rest mass into usable energy. The colony must supply fuel, cooling and maintenance for this extreme engineering process."

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEPROTOANNIHILATIONREACTOR.EFFECT"
msgid "Consumes 0.02 kg/s Proto-Matter. Gross power 48 kW; operation 8 kW; net 40 kW. Transfers 200 kDTU/s to a liquid cooling loop. Cold ignition needs 600 kJ of paid power. Radiation shielding is needed in radiation-enabled colonies."
msgstr "Consumes 0.02 kg/s Proto-Matter. Gross power 48 kW; operation 8 kW; net 40 kW. Transfers 200 kDTU/s to a liquid cooling loop. Cold ignition needs 600 kJ of paid power. Radiation shielding is needed in radiation-enabled colonies."

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEENERGYMATTERCONDENSER.NAME"
msgid "Energy-Matter Condenser"
msgstr "Energy-Matter Condenser"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEENERGYMATTERCONDENSER.DESC"
msgid "Condenses purchased electrical energy into physical Proto-Matter, with irreversible conversion losses."
msgstr "Condenses purchased electrical energy into physical Proto-Matter, with irreversible conversion losses."

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEENERGYMATTERCONDENSER.EFFECT"
msgid "Consumes 36 kW. Each 18 MJ of paid work produces 1 kg Proto-Matter in 500 seconds and transfers 6 MJ of heat to coolant. Stores outputs for manual or conveyor pickup."
msgstr "Consumes 36 kW. Each 18 MJ of paid work produces 1 kg Proto-Matter in 500 seconds and transfers 6 MJ of heat to coolant. Stores outputs for manual or conveyor pickup."

msgctxt "STRINGS.RESEARCH.TECHS.BAIYEFORBIDDENMASSENERGYENGINEERING.NAME"
msgid "Forbidden Mass-Energy Engineering"
msgstr "Forbidden Mass-Energy Engineering"

msgctxt "STRINGS.RESEARCH.TECHS.BAIYEFORBIDDENMASSENERGYENGINEERING.DESC"
msgid "Push confinement and mass-energy conversion beyond known industrial limits. Requires fuel, paid power, thermal control and maintenance."
msgstr "Push confinement and mass-energy conversion beyond known industrial limits. Requires fuel, paid power, thermal control and maintenance."

