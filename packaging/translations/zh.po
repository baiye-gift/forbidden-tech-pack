msgstr "{Detail}"

msgctxt "STRINGS.UI.MATTER.CHOOSE"
msgid "Choose a material and queue an order"
msgstr "选择材料并安排生产"

msgctxt "STRINGS.UI.MATTER.WORKING"
msgid "Processing {0}: {1:0}%"
msgstr "正在处理 {0}：{1:0}%"

msgctxt "STRINGS.UI.MATTER.WAITING_OPERATOR"
msgid "Waiting for an operator"
msgstr "等待复制人操作"

msgctxt "STRINGS.UI.MATTER.NO_UNLOCKS"
msgid "No materials analyzed yet"
msgstr "尚未分析任何材料"

msgctxt "STRINGS.UI.MATTER.UNLOCK_HELP"
msgid "Collect 10 kg of an eligible solid and complete an order in the Matter Analyzer first."
msgstr "先收集 10 kg 可处理固体，在物质分析仪中完成一次分析。"

msgctxt "STRINGS.UI.MATTER.ALL_ANALYZED"
msgid "No remaining eligible samples"
msgstr "没有待分析的合格样本"

msgctxt "STRINGS.UI.MATTER.SAMPLE_HELP"
msgid "All currently eligible solids are analyzed, or disabled by the selected preset."
msgstr "当前允许的固体已分析完毕，或被所选预设排除。"

msgctxt "STRINGS.UI.MATTER.MISSING"
msgid "Waiting for {0}"
msgstr "等待 {0}"

msgctxt "STRINGS.UI.MATTER.INGREDIENT_HELP"
msgid "Input: {0:0.##} / {1:0.##} kg of {2}. Supply it through manual delivery, an auto-sweeper, or the building's input rail where supported."
msgstr "输入库存：{0:0.##} / {1:0.##} kg {2}。使用复制人、自动清扫器或本建筑支持的输入轨道送料。"

msgctxt "STRINGS.UI.MATTER.OUTPUT_FULL"
msgid "Waiting for output space"
msgstr "等待成品仓腾出空间"

msgctxt "STRINGS.UI.MATTER.OUTPUT_HELP"
msgid "Output: {0:0.##} / {1:0.##} kg. Remove the stored products manually or connect an unblocked output rail."
msgstr "成品库存：{0:0.##} / {1:0.##} kg。手动取走成品，或接通未堵塞的输出轨道。"

msgctxt "STRINGS.UI.MATTER.NOT_OPERATIONAL"
msgid "Waiting for the building to become operational"
msgstr "等待建筑恢复运行"

msgctxt "STRINGS.UI.MATTER.OPERATION_HELP"
msgid "Check the native power, automation, flooded, buried, or damaged status above. Paused inputs and completed products stay in storage."
msgstr "查看原生状态中的电力、自动化、淹没、掩埋或损坏提示。停机保留输入和已有成品。"

msgctxt "STRINGS.UI.MATTER.COOLANT_EMPTY"
msgid "Waiting for liquid coolant"
msgstr "等待液体冷却剂"

msgctxt "STRINGS.UI.MATTER.COOLANT_DRAIN"
msgid "Waiting for coolant to leave"
msgstr "等待冷却液排出"

msgctxt "STRINGS.UI.MATTER.COOLANT_HOT"
msgid "Coolant is too hot"
msgstr "冷却液温度过高"

msgctxt "STRINGS.UI.MATTER.COOLANT_HELP"
msgid "Coolant: {0:0.##} / 10 kg, {1}. Connect liquid input and output. A heated packet is held until the outlet accepts it; unsafe unheated coolant is returned unchanged."
msgstr "冷却库存：{0:0.##} / 10 kg，{1}。接通液体入口和出口；加热后的液包保留至出口接收，无法安全加热的冷却液原温返回。"

msgctxt "STRINGS.UI.MATTER.HEATED_BUFFER"
msgid "Return buffer: {0:0.##} / 10 kg. This liquid keeps its heat and germs until the outlet accepts it."
msgstr "回流库存：{0:0.##} / 10 kg。出口接收前保留液体的热量和病菌。"

msgctxt "STRINGS.UI.MATTER.ACCOUNTS"
msgid "Batch: {0:0.##} kg input → {1:0.##} kg output; base processing time {2:0.##} s. Current input {3:0.##} kg, reserved input {4:0.##} kg, output {5:0.##} kg. Native inventory entries show actual temperatures and germs."
msgstr "每批 {0:0.##} kg 输入 → {1:0.##} kg 成品；基础有效加工时间 {2:0.##} 秒。输入仓 {3:0.##} kg，制作中 {4:0.##} kg，成品仓 {5:0.##} kg。实际温度和病菌见原生库存条目。"

msgctxt "STRINGS.ELEMENTS.BAIYEFORBIDDENPROTOMATTER.DESC"
msgid "A dense, stable aggregate with a dark crust, violet grains and cyan inner strata. Produced by mass crushing or paid energy condensation; used for material compilation and controlled annihilation. Recoverable energy budget: up to 12 MJ/kg; condensation costs 18 MJ/kg. Store and convey it as a solid. The material itself is non-radioactive; radiation occurs inside the active reactor."
msgstr "具有深色外壳、紫色晶粒与青色内层的致密稳定聚合物。通过质量粉碎或耗电凝聚获得，可用于物质编译与受控湮灭。每千克原质的可回收能量上限为 12 MJ，凝聚需要 18 MJ。按固体储存与运输；原质本身无放射性，运行中的湮灭炉会产生辐射。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEPROTOANNIHILATIONREACTOR.NAME"
msgid "Proto-Matter Annihilation Reactor"
msgstr "原质湮灭反应炉"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEPROTOANNIHILATIONREACTOR.DESC"
msgid "Experimental confinement converts Proto-Matter rest mass into usable energy. The colony must supply fuel, cooling and maintenance for this extreme engineering process."
msgstr "利用实验性约束场，将原质的静质量转化为可用能量。殖民地需要承担极限工程的供料、散热与维护压力。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEPROTOANNIHILATIONREACTOR.EFFECT"
msgid "Consumes 0.02 kg/s Proto-Matter. Gross power 48 kW; operation 8 kW; net 40 kW. Transfers 200 kDTU/s to a liquid cooling loop. Cold ignition needs 600 kJ of paid power. Radiation shielding is needed in radiation-enabled colonies."
msgstr "持续消耗 0.02 kg/s 原质。总发电 48 kW，运行耗电 8 kW，净发电 40 kW；向液体冷却回路传入 200 kDTU/s 废热。冷启动需要实际支付 600 kJ 电力。启用辐射的殖民地需要屏蔽设施。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEENERGYMATTERCONDENSER.NAME"
msgid "Energy-Matter Condenser"
msgstr "质能凝聚器"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEENERGYMATTERCONDENSER.DESC"
msgid "Condenses purchased electrical energy into physical Proto-Matter, with irreversible conversion losses."
msgstr "以不可逆的转换损耗，将实际投入的电能凝聚为可搬运的原质。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEENERGYMATTERCONDENSER.EFFECT"
msgid "Consumes 36 kW. Each 18 MJ of paid work produces 1 kg Proto-Matter in 500 seconds and transfers 6 MJ of heat to coolant. Stores outputs for manual or conveyor pickup."
msgstr "运行耗电 36 kW。每批实际支付 18 MJ 电力，经过 500 秒有效加工生成 1 kg 原质，并向冷却液传入 6 MJ 废热。成品可手动取走或通过运输轨道排出。"

msgctxt "STRINGS.RESEARCH.TECHS.BAIYEFORBIDDENMASSENERGYENGINEERING.NAME"
msgid "Forbidden Mass-Energy Engineering"
msgstr "禁忌质能工程"

msgctxt "STRINGS.RESEARCH.TECHS.BAIYEFORBIDDENMASSENERGYENGINEERING.DESC"
msgid "Push confinement and mass-energy conversion beyond known industrial limits. Requires fuel, paid power, thermal control and maintenance."
msgstr "将约束场与质能转换推向工业极限。需要持续供料、实际供电、热管理与工程维护。"

msgctxt "STRINGS.RESEARCH.TECHS.BAIYEFORBIDDENMASSENERGYENGINEERING.SEARCH_TERMS"
msgid "annihilation energy matter condenser proto reactor"
msgstr "禁忌 湮灭 原质 质能 凝聚 反应炉"

msgctxt "STRINGS.UI.MASSENERGY.FUEL_EMPTY"
msgid "Waiting for Proto-Matter fuel"
msgstr "等待原质燃料"

msgctxt "STRINGS.UI.MASSENERGY.POWER_FULL"
msgid "Waiting for generated energy to leave"
msgstr "等待电网接收发电"

msgctxt "STRINGS.UI.MASSENERGY.IGNITING"
msgid "Charging confinement: {0:0}%"
msgstr "约束场蓄能：{0:0}%"

msgctxt "STRINGS.UI.MASSENERGY.REACTING"
msgid "Controlled Proto-Matter annihilation"
msgstr "正在进行受控原质湮灭"

msgctxt "STRINGS.UI.MASSENERGY.READY"
msgid "Confinement ready; waiting for paid operating power"
msgstr "约束场已就绪，等待运行供电"

msgctxt "STRINGS.UI.MASSENERGY.CONDENSING"
msgid "Condensing Proto-Matter: {0:0}%"
msgstr "正在凝聚原质：{0:0}%"

msgctxt "STRINGS.UI.MASSENERGY.REACTOR_DETAIL"
msgid "Fuel: {0:0.###} / 120 kg. Ignition paid: {1:0.#} / 600 kJ. Generator buffer: {2:0.#} / 96 kJ. Lifetime annihilated: {3:0.###} kg; gross generation: {4:0.###} MJ. Connect a fuel rail or allow deliveries, a powered wire for ignition, and an external liquid heat sink. Full rates: 48 kW gross, 8 kW operating, 40 kW net, 200 kDTU/s coolant heat. Stored ignition survives pauses and saves. Native overheating damage requires repair."
msgstr "燃料：{0:0.###} / 120 kg。启动已支付：{1:0.#} / 600 kJ。发电缓存：{2:0.#} / 96 kJ。累计湮灭：{3:0.###} kg；累计总发电：{4:0.###} MJ。\n接通燃料轨道或允许复制人送料，连接启动电源与外部液体散热回路。\n满负荷：总发电 48 kW，运行耗电 8 kW，净发电 40 kW，冷却废热 200 kDTU/s。启动蓄能在暂停及存档后保留。过热损坏需要维修。"

msgctxt "STRINGS.UI.MASSENERGY.CONDENSER_DETAIL"
msgid "Current order paid: {0:0.###} / 18 MJ. Output: {1:0.###} / 20 kg. Full rate: 36 kW, 1 kg per 500 seconds, 12 kDTU/s coolant heat. Queue an order or an infinite queue, supply power/coolant, and remove completed products. Cancellation returns no spent electricity and does not undo heat."
msgstr "当前订单已支付：{0:0.###} / 18 MJ。成品：{1:0.###} / 20 kg。\n安排订单或设置无限生产，接通电力与冷却回路，及时移走成品。\n满负荷：耗电 36 kW，每 500 秒生成 1 kg 原质，冷却废热 12 kDTU/s。取消订单不返还已消耗的电力，也不撤销已产生的热量。"

msgctxt "STRINGS.UI.MASSENERGY.CONDENSE_RECIPE"
msgid "Condense 1 kg of physical Proto-Matter using 18 MJ of paid electrical work. Transfers 6 MJ to coolant, with up to 12 MJ/kg recoverable material energy. Even full annihilation heat recovery cannot create a gain cycle."
msgstr "实际支付 18 MJ 电力，凝聚 1 kg 原质。向冷却液传入 6 MJ 废热，原质保留至多 12 MJ/kg 可回收能量。即使回收全部湮灭废热，循环转换也无法产生能量增益。"
