msgctxt "STRINGS.ELEMENTS.BAIYEFORBIDDENPROTOMATTER.NAME"
msgid "Proto-Matter"
msgstr "原质"

msgctxt "STRINGS.ELEMENTS.BAIYEFORBIDDENPROTOMATTER.DESC"
msgid "A compact, transportable substrate produced by forbidden matter processing."
msgstr "由禁忌物质处理生成的紧凑、可运输基质。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMASSCRUSHER.NAME"
msgid "Mass Crusher"
msgstr "质量粉碎机"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMASSCRUSHER.DESC"
msgid "Breaks solid materials into transportable Proto-Matter."
msgstr "将固体材料分解为可运输的原质。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMASSCRUSHER.EFFECT"
msgid "Consumes solid materials and produces Proto-Matter. Supports solid conveyor rails."
msgstr "消耗固体材料并生成原质，支持固体运输轨道。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMASSCRUSHER.LOGIC_PORT.NAME"
msgid "Enable Mass Crusher"
msgstr "启用质量粉碎机"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMASSCRUSHER.LOGIC_PORT.ACTIVE"
msgid "When receiving a Green signal, the Mass Crusher may operate."
msgstr "收到绿信号时，质量粉碎机可以运行。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMASSCRUSHER.LOGIC_PORT.INACTIVE"
msgid "When receiving a Red signal, the Mass Crusher is disabled."
msgstr "收到红信号时，质量粉碎机停止运行。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERANALYZER.NAME"
msgid "Matter Analyzer"
msgstr "物质分析仪"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERANALYZER.DESC"
msgid "Studies a physical material sample to unlock forbidden matter recipes."
msgstr "研究实体材料样本，以解锁禁忌物质配方。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERANALYZER.EFFECT"
msgid "Consumes a material sample, then unlocks it for Matter Compilation."
msgstr "消耗一份材料样本，并将其解锁用于物质编译。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERANALYZER.SAMPLE_ALREADY_ANALYZED"
msgid "This material has already been analyzed."
msgstr "该材料已完成分析。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERANALYZER.LOGIC_PORT.NAME"
msgid "Enable Analyzer"
msgstr "启用分析仪"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERANALYZER.LOGIC_PORT.ACTIVE"
msgid "When receiving a Green signal, the Matter Analyzer may operate."
msgstr "收到绿信号时，物质分析仪可以运行。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERANALYZER.LOGIC_PORT.INACTIVE"
msgid "When receiving a Red signal, the Matter Analyzer is disabled."
msgstr "收到红信号时，物质分析仪停止运行。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERCOMPILER.NAME"
msgid "Matter Compiler"
msgstr "物质编译器"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERCOMPILER.DESC"
msgid "Reassembles Proto-Matter into analyzed solid materials."
msgstr "将原质重新组装为已分析的固体材料。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERCOMPILER.EFFECT"
msgid "Consumes Proto-Matter and a safe liquid coolant loop to compile unlocked materials."
msgstr "消耗原质并利用安全液体冷却回路编译已解锁材料。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERCOMPILER.LOGIC_PORT.NAME"
msgid "Enable Matter Compiler"
msgstr "启用物质编译器"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERCOMPILER.LOGIC_PORT.ACTIVE"
msgid "When receiving a Green signal, the Matter Compiler may operate."
msgstr "收到绿信号时，物质编译器可以运行。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERCOMPILER.LOGIC_PORT.INACTIVE"
msgid "When receiving a Red signal, the Matter Compiler is disabled."
msgstr "收到红信号时，物质编译器停止运行。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERRECONSTRUCTOR.NAME"
msgid "Matter Reconstructor"
msgstr "物质重构器"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERRECONSTRUCTOR.DESC"
msgid "Uses Proto-Matter to lever reality and rewrite an existing material substrate into an analyzed structure."
msgstr "利用原质撬动现实，将已有物质基质的结构重写为已解析的目标结构。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERRECONSTRUCTOR.EFFECT"
msgid "Consumes a tier-matched reality substrate and Proto-Matter to produce an equal mass of an analyzed target material."
msgstr "消耗匹配层级的现实基质与原质，将现实基质等质量重构为已解析的目标材料。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERRECONSTRUCTOR.NO_RECIPES"
msgid "No analyzed reconstruction targets are available."
msgstr "当前没有已解析的可重构目标。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERRECONSTRUCTOR.WAITING_SUBSTRATE"
msgid "Waiting for a compatible reality substrate."
msgstr "等待兼容的现实基质。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERRECONSTRUCTOR.WAITING_PROTO_MATTER"
msgid "Waiting for Proto-Matter."
msgstr "等待原质。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERRECONSTRUCTOR.OUTPUT_BLOCKED"
msgid "Reconstructed material output is blocked."
msgstr "重构材料输出受阻。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERRECONSTRUCTOR.INTERFERED"
msgid "Proto-Matter interference has destabilized reality anchoring. Reconstruction is paused."
msgstr "原质干扰使现实锚定失稳，重构已暂停。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERRECONSTRUCTOR.LOGIC_PORT.NAME"
msgid "Enable Matter Reconstructor"
msgstr "启用物质重构器"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERRECONSTRUCTOR.LOGIC_PORT.ACTIVE"
msgid "When receiving a Green signal, the Matter Reconstructor may operate."
msgstr "收到绿信号时，物质重构器可以运行。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERRECONSTRUCTOR.LOGIC_PORT.INACTIVE"
msgid "When receiving a Red signal, the Matter Reconstructor is disabled."
msgstr "收到红信号时，物质重构器停止运行。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEENTROPYFLUXDIVERTER.NAME"
msgid "Entropy Flux Diverter"
msgstr "熵流偏转器"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEENTROPYFLUXDIVERTER.DESC"
msgid "Uses a Proto-Matter field to establish an artificial thermodynamic coupling between two liquid streams."
msgstr "利用原质场在两股液体之间建立人工热力学耦合。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEENTROPYFLUXDIVERTER.EFFECT"
msgid "Moves equal thermal energy from a hotter liquid stream into a colder one while consuming a small amount of Proto-Matter. It does not delete heat."
msgstr "消耗少量原质，将等量热能从高温液流偏转到低温液流，不会凭空删除热量。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEENTROPYFLUXDIVERTER.WAITING_HOT"
msgid "Waiting for hot liquid."
msgstr "等待高温液体。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEENTROPYFLUXDIVERTER.WAITING_COLD"
msgid "Waiting for cold liquid."
msgstr "等待低温液体。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEENTROPYFLUXDIVERTER.WAITING_PROTO_MATTER"
msgid "Waiting for Proto-Matter."
msgstr "等待原质。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEENTROPYFLUXDIVERTER.NO_GRADIENT"
msgid "No usable thermal gradient is present."
msgstr "当前不存在可利用的温差。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEENTROPYFLUXDIVERTER.PHASE_LIMITED"
msgid "Transfer is limited by a liquid phase boundary."
msgstr "热量转移受液体相变边界限制。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEENTROPYFLUXDIVERTER.TRANSFERRING"
msgid "Redirecting entropy between the two liquid streams."
msgstr "正在两股液流之间偏转熵流。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEENTROPYFLUXDIVERTER.OUTPUT_BLOCKED"
msgid "A processed liquid output is blocked."
msgstr "处理后的液体输出受阻。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEENTROPYFLUXDIVERTER.INTERFERED"
msgid "Proto-Matter interference has broken the coupling field. Transfer is paused."
msgstr "原质干扰破坏了耦合场，热量转移已暂停。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEENTROPYFLUXDIVERTER.LOGIC_PORT.NAME"
msgid "Enable Entropy Flux Diverter"
msgstr "启用熵流偏转器"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEENTROPYFLUXDIVERTER.LOGIC_PORT.ACTIVE"
msgid "When receiving a Green signal, the Entropy Flux Diverter may operate."
msgstr "收到绿信号时，熵流偏转器可以运行。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEENTROPYFLUXDIVERTER.LOGIC_PORT.INACTIVE"
msgid "When receiving a Red signal, the Entropy Flux Diverter is disabled."
msgstr "收到红信号时，熵流偏转器停止运行。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERANNIHILATIONREACTOR.NAME"
msgid "Matter Annihilation Reactor"
msgstr "物质湮灭堆"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERANNIHILATIONREACTOR.DESC"
msgid "Confines Proto-Matter at the boundary of reality and deliberately relaxes its material anchor to release usable energy."
msgstr "将原质约束在现实边界，并主动削弱其物质锚定以释放可利用能量。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERANNIHILATIONREACTOR.EFFECT"
msgid "Requires external power to establish confinement, then consumes Proto-Matter to generate large amounts of electricity and heat. Cooling or confinement failure can trigger localized Proto-Matter decoherence."
msgstr "需要外部供电建立约束场，随后消耗原质产生大量电力和热量；冷却或约束失效可能触发局部原质退相干。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERANNIHILATIONREACTOR.OFFLINE"
msgid "Reactor offline."
msgstr "反应堆离线。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERANNIHILATIONREACTOR.CHARGING"
msgid "Charging confinement field."
msgstr "正在为约束场充能。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERANNIHILATIONREACTOR.STABLE"
msgid "Stable annihilation reaction."
msgstr "湮灭反应稳定。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERANNIHILATIONREACTOR.FLUCTUATING"
msgid "Constraint field fluctuating."
msgstr "约束场正在波动。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERANNIHILATIONREACTOR.CRITICAL"
msgid "Proto-Matter confinement is at the decoherence threshold."
msgstr "原质约束已逼近退相干临界点。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERANNIHILATIONREACTOR.DECOHERED"
msgid "Proto-Matter decohered. Emergency lockout engaged."
msgstr "原质已发生退相干，紧急锁定已启动。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERANNIHILATIONREACTOR.LOCKOUT"
msgid "Cooling lockout active."
msgstr "冷却锁定中。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERANNIHILATIONREACTOR.WAITING_PROTO_MATTER"
msgid "Waiting for Proto-Matter."
msgstr "等待原质。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERANNIHILATIONREACTOR.COOLING_INSUFFICIENT"
msgid "Coolant cannot safely absorb reactor heat."
msgstr "冷却液无法安全吸收反应堆热量。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERANNIHILATIONREACTOR.POWER_INSUFFICIENT"
msgid "Constraint power is insufficient."
msgstr "约束场外部供电不足。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERANNIHILATIONREACTOR.INTERFERED"
msgid "External Proto-Matter interference is destabilizing confinement."
msgstr "外部原质干扰正在使约束场失稳。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERANNIHILATIONREACTOR.LOGIC_PORT.NAME"
msgid "Enable Matter Annihilation Reactor"
msgstr "启用物质湮灭堆"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERANNIHILATIONREACTOR.LOGIC_PORT.ACTIVE"
msgid "When receiving a Green signal, the reactor may charge or sustain confinement."
msgstr "收到绿信号时，物质湮灭堆可以充能或维持约束场。"

msgctxt "STRINGS.BUILDINGS.PREFABS.BAIYEMATTERANNIHILATIONREACTOR.LOGIC_PORT.INACTIVE"
msgid "When receiving a Red signal, the reactor performs an orderly shutdown into cooling lockout."
msgstr "收到红信号时，物质湮灭堆将有序停机并进入冷却锁定。"

msgctxt "STRINGS.BUILDING.STATUSITEMS.BAIYEMATTERCOMPILERUNSAFECOOLANT.NAME"
msgid "Waiting for Safe Coolant"
msgstr "等待安全冷却液"

msgctxt "STRINGS.BUILDING.STATUSITEMS.BAIYEMATTERCOMPILERUNSAFECOOLANT.TOOLTIP"
msgid "A liquid packet that can absorb the process heat and an open coolant output are required."
msgstr "需要能够吸收工艺热量的液体包，并确保冷却液出口畅通。"

msgctxt "STRINGS.RESEARCH.TECHS.BAIYEFORBIDDENMATTERENGINEERING.NAME"
msgid "Forbidden Matter Engineering"
msgstr "禁忌物质工程"

msgctxt "STRINGS.RESEARCH.TECHS.BAIYEFORBIDDENMATTERENGINEERING.DESC"
msgid "Reverse-engineer matter itself and build machines that analyze, deconstruct, and compile solid materials."
msgstr "逆向解析物质本身，并建造能够分析、分解和编译固体材料的机器。"

msgctxt "STRINGS.RESEARCH.TECHS.BAIYEFORBIDDENMATTERENGINEERING.SEARCH_TERMS"
msgid "forbidden matter proto-matter analyzer crusher compiler"
msgstr "禁忌 物质 原质 分析仪 粉碎机 编译器"

msgctxt "STRINGS.RESEARCH.TECHS.BAIYEFORBIDDENPROTOFIELDENGINEERING.NAME"
msgid "Proto-Matter Field Engineering"
msgstr "原质场工程"

msgctxt "STRINGS.RESEARCH.TECHS.BAIYEFORBIDDENPROTOFIELDENGINEERING.DESC"
msgid "Use Proto-Matter as a dimensional coupling medium to lever reality itself and drive advanced forbidden machinery."
msgstr "以原质作为维度耦合介质，撬动现实本身并驱动更高阶的禁忌科技设备。"

msgctxt "STRINGS.RESEARCH.TECHS.BAIYEFORBIDDENPROTOFIELDENGINEERING.SEARCH_TERMS"
msgid "proto-matter field dimensional coupling reconstruction reality reconstructor entropy diverter annihilation reactor forbidden"
msgstr "原质 原质场 维度 耦合 重构 现实 物质重构器 熵流偏转器 物质湮灭堆 禁忌"

msgctxt "STRINGS.UI.SAFEREMOVAL.TITLE"
msgid "Safe Removal - Forbidden Technology Pack"
msgstr "安全移除 - 禁忌科技包"

msgctxt "STRINGS.UI.SAFEREMOVAL.FIRST_WARNING"
msgid "This workflow permanently prepares the current colony for disabling this mod. It will stop the forbidden matter machines, return their stored inputs, and remove the custom buildings. Continue only after making a normal save first."
msgstr "此流程会永久准备当前殖民地以停用本模组：停止禁忌物质设备、返还已存输入并移除自定义建筑。请先正常保存后再继续。"

msgctxt "STRINGS.UI.SAFEREMOVAL.SECOND_WARNING"
msgid "Final confirmation: convert every Proto-Matter object to Igneous Rock and stop/remove all forbidden matter buildings now? Completed ordinary outputs are preserved. This action cannot be undone except by reloading an earlier save."
msgstr "最终确认：现在将所有原质转换为火成岩，并停止/移除全部禁忌物质建筑？已完成的普通产物会保留。除非读取更早存档，否则无法撤销。"

msgctxt "STRINGS.UI.SAFEREMOVAL.CONTINUE"
msgid "Continue"
msgstr "继续"

msgctxt "STRINGS.UI.SAFEREMOVAL.CONVERT_AND_STOP"
msgid "Convert Proto-Matter and Stop Buildings"
msgstr "转换原质并停止建筑"

msgctxt "STRINGS.UI.SAFEREMOVAL.CANCEL"
msgid "Cancel"
msgstr "取消"

msgctxt "STRINGS.UI.SAFEREMOVAL.CLOSE"
msgid "Close"
msgstr "关闭"

msgctxt "STRINGS.UI.SAFEREMOVAL.NO_ACTIVE_GAME"
msgid "Load the colony you want to prepare before starting safe removal."
msgstr "开始安全移除前，请先载入需要处理的殖民地。"

msgctxt "STRINGS.UI.SAFEREMOVAL.SUCCESS"
msgid "Safe removal scan is complete. Converted {0} Proto-Matter objects ({1:0.##} kg), removed {2} custom buildings, and returned {3} stored input objects. Save the colony under a new name, reload that save once, verify it opens normally, and only then disable the mod."
msgstr "安全移除扫描完成。已转换 {0} 个原质对象（{1:0.##} kg），移除 {2} 个自定义建筑，并返还 {3} 个已存输入对象。请以新名称保存殖民地，重新载入一次并确认可正常打开后，再停用本模组。"

msgctxt "STRINGS.UI.SAFEREMOVAL.INCOMPLETE"
msgid "Safe removal is not complete. {0} custom objects remain. Keep the mod enabled, reload the colony if necessary, and run Safe Removal again. Do not disable the mod yet."
msgstr "安全移除尚未完成，仍有 {0} 个自定义对象。请保持模组启用，必要时重新载入殖民地并再次执行安全移除。暂时不要停用本模组。"
